# Copy this file to .env.local and fill in real values for local dev.
# In production (Netlify), set these same keys under Site settings > Environment variables.
# Vite only exposes vars prefixed with VITE_ to client code — never put secrets that
# shouldn't be public here, since these end up in the client-side JS bundle.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
